{
  "name": "postq",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup:local": "node scripts/setup-local.mjs && wrangler d1 migrations apply DB --local",
    "build:cloudflare": "opennextjs-cloudflare build",
    "preview:cloudflare": "pnpm build:cloudflare && wrangler d1 migrations apply DB --local && wrangler dev --local --var POSTQ_PUBLISHING_PAUSED:yes",
    "deploy:cloudflare": "pnpm build:cloudflare && wrangler d1 migrations apply DB --remote && wrangler deploy",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --experimental-transform-types --import ./tests/register.mjs --test tests/*.test.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.94",
    "@ai-sdk/google": "^4.0.109",
    "@ai-sdk/openai": "^4.0.106",
    "@ai-sdk/openai-compatible": "^3.0.82",
    "@ai-sdk/react": "^4.0.166",
    "@base-ui/react": "^1.9.0",
    "@modelcontextprotocol/server": "2.4.0",
    "ai": "^7.0.162",
    "better-auth": "^1.7.15",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "fast-png": "^8.0.0",
    "image-size": "^2.0.4",
    "jpeg-js": "^0.4.4",
    "lucide-react": "^1.66.0",
    "mediabunny": "^1.65.1",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "streamdown": "^2.7.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.16",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "4.156.1"
  },
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22.16.0 <25"
  }
}
