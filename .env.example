# Copy to .env.local and fill in the features you want to use.
# On Cloudflare, add these values to the Worker's Variables and Secrets.

# App bootstrap. Google sign-in is optional and can be configured in Settings.
POSTQ_OWNER_EMAIL=
# Required to create the first owner. Generate at least 32 random characters.
POSTQ_BOOTSTRAP_TOKEN=
# Keep this stable when rotating the auth/session secret. Back it up separately.
POSTQ_ENCRYPTION_KEY=
# Optional previous encryption key during a controlled rotation.
POSTQ_PREVIOUS_ENCRYPTION_KEY=
# Exact comma-separated hosts for custom AI providers; defaults include common providers.
POSTQ_AI_ALLOWED_HOSTS=
# Optional scheduler pause; set exactly yes to stop social mutations.
POSTQ_PUBLISHING_PAUSED=
# Optional history deletion policy, 30–3650 days; absent means retain history.
POSTQ_RETENTION_DAYS=
# Initial fallback; the owner can save an IANA timezone in Settings.
POSTQ_TIMEZONE=UTC
BETTER_AUTH_URL=http://localhost:3000
# Generate a random secret of at least 32 characters.
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Threads publishing through Composio
COMPOSIO_API_KEY=
COMPOSIO_AUTH_CONFIG_THREADS=
COMPOSIO_AUTH_CONFIG_TIKTOK=
# Set to enabled only for a deployment that TikTok has authorized for Direct Post.
POSTQ_TIKTOK_DIRECT_POST=
COMPOSIO_AUTH_CONFIG_TWITTER=

# AI captions. Choose google, openai, anthropic, or openai-compatible.
AI_PROVIDER=
AI_MODEL=
# Optional comma-separated model IDs for the configured provider.
AI_MODELS=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_COMPATIBLE_API_KEY=
# Required for openai-compatible. Use an HTTPS endpoint.
OPENAI_COMPATIBLE_BASE_URL=

# Optional Settings -> Apply configuration to Worker.
# Configure these server-side. Use an account-scoped Workers Scripts Write token.
POSTQ_CLOUDFLARE_API_TOKEN=
POSTQ_CLOUDFLARE_ACCOUNT_ID=
POSTQ_CLOUDFLARE_WORKER=
